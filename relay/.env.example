# Relay server environment variables
# ─────────────────────────────────────────────────────────────────────────────
# For local dev:   copy to relay/.env  →  make relay
# For Railway:     set these as environment variables in the Railway dashboard
# ─────────────────────────────────────────────────────────────────────────────

# Random secret used to sign JWT tokens.
# Generate a good one: openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32

# Password for the iOS app login screen.
ADMIN_PASSWORD=your-secure-password

# Pre-shared secret that agents use to authenticate with the relay.
# Must match AGENT_SECRET in each agent's .env.
AGENT_SECRET=your-agent-secret

# Port to listen on (Railway sets this automatically, no need to change).
PORT=8080

# Optional native TLS (serve https/wss directly). Set BOTH to enable — only
# needed when self-hosting the relay on a public host with your own cert.
# Leave unset for Tailscale, Cloudflare Tunnel, or a platform that terminates
# TLS for you (Railway/fly.io). See docs/REMOTE-ACCESS.md.
# TLS_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem
